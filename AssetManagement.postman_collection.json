{
  "info": {
    "name": "Gestion de Activos TI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "assetId",
      "value": "1"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin#2026!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (operador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operador\",\n  \"password\": \"Operador#2026!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Activos",
      "item": [
        {
          "name": "Listar con filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets?search=DELL&status=Disponible&category=Laptop&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "DELL"
                },
                {
                  "key": "status",
                  "value": "Disponible"
                },
                {
                  "key": "category",
                  "value": "Laptop"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Obtener por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}"
              ]
            }
          }
        },
        {
          "name": "Crear (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"assetId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetCode\": \"TI-0009001\",\n  \"serialNumber\": \"SN-NEW-0001\",\n  \"category\": \"Laptop\",\n  \"brand\": \"DELL\",\n  \"model\": \"Latitude 7440\",\n  \"ownershipType\": \"Propio\",\n  \"currentLocation\": \"Almacen central\",\n  \"purchaseDate\": \"2026-01-15\",\n  \"notes\": \"Alta desde Postman\"\n}"
            }
          }
        },
        {
          "name": "Actualizar (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serialNumber\": \"SN-NEW-0001\",\n  \"category\": \"Laptop\",\n  \"brand\": \"DELL\",\n  \"model\": \"Latitude 7440\",\n  \"ownershipType\": \"Propio\",\n  \"status\": \"Mantenimiento\",\n  \"currentLocation\": \"Taller\",\n  \"notes\": \"Cambio de bateria\"\n}"
            }
          }
        },
        {
          "name": "Historial",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}",
                "history"
              ]
            }
          }
        },
        {
          "name": "Asignar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}",
                "assign"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 1,\n  \"notes\": \"Entrega a colaborador\"\n}"
            }
          }
        },
        {
          "name": "Devolver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets/{{assetId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "assets",
                "{{assetId}}",
                "return"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"condition\": \"Bueno\",\n  \"notes\": \"Sin novedades\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Colaboradores",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search=ana&isActive=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "ana"
                },
                {
                  "key": "isActive",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Obtener por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Crear (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeNumber\": \"E-0100\",\n  \"fullName\": \"Nuevo Colaborador\",\n  \"email\": \"nuevo@empresa.example\",\n  \"department\": \"Operaciones\",\n  \"isActive\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Proveedores",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/suppliers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "suppliers"
              ]
            }
          }
        },
        {
          "name": "Obtener por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/suppliers/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "suppliers",
                "1"
              ]
            }
          }
        },
        {
          "name": "Crear (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/suppliers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "suppliers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Proveedor Nuevo SA\",\n  \"taxId\": \"PNU030303CCC\",\n  \"email\": \"ventas@proveedor.example\",\n  \"phone\": \"5550003\",\n  \"services\": [\n    \"Compra\",\n    \"Arrendamiento\"\n  ]\n}"
            }
          }
        }
      ]
    }
  ]
}